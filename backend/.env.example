EXOQML_APP_ENV=development
EXOQML_API_PREFIX=/api/v1
EXOQML_DATABASE_URL=sqlite:///./exoqml.db
EXOQML_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
EXOQML_MAX_POINTS=2048
EXOQML_ENABLE_QML=false
EXOQML_ALLOW_SYNTHETIC_FALLBACK=true
EXOQML_MODEL_PATH=
EXOQML_QML_MODEL_PATH=
EXOQML_DEVICE=auto
EXOQML_CACHE_DIR=./data/cache
EXOQML_LOG_LEVEL=INFO
